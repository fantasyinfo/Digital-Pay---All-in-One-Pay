import {
  ApiKeysLive,
  ApiKeysSandbox,
  CallBackUrl,
} from "../../../utils/apiKeys.js";
import {
  Modes,
  PaymentGateways,
  PaymentStatus,
  __company,
} from "../../../utils/constants.js";
import { responseHandler } from "../../../utils/responseHandler.js";
import {
  validateBody,
  validateParams,
  validate_data,
  validators,
} from "../../../utils/functionsUtil.js";
import axios from "axios";
import Transaction from "../../../models/gateway/Transactions.js";
import PaymentResponse from "../../../utils/paymentResponse.js";
import { ValidateGatewayKeys } from "../../../utils/getValidateGatewayKeys.js";

export const paypal_createPayment = async (req, res) => {
  const _body = req.body;
  const mode = req.mode;
  const userId = req.userId;

  // check keys...
  const validator = new ValidateGatewayKeys(mode, _body, req, res, "paypal");
  validator.get();

  // initilize the secret key & id...
  const gatewayClientId = validator.gatewayClientID;
  const gatewaySecretKey = validator.gatewaySecretKey;
  const gatewayUrlAPI = validator.gatewayURL;

  try {
    const accessToken = await getAccessToken(
      gatewayUrlAPI,
      gatewayClientId,
      gatewaySecretKey
    );

    // check paypal required fields

    const isValid = validateBodyFields(_body, req, res);
    if (!isValid) {
      return;
    }

    // create transation...
    const gatewayUrl = `${gatewayUrlAPI}/v2/checkout/orders`;
    const checkOutRes = await checkOutTrans(
      gatewayUrl,
      accessToken,
      mode,
      userId,
      _body
    );

    // create response to send...
    const _data = new PaymentResponse(
      checkOutRes.payUrl,
      checkOutRes.orderResponse?.data,
      checkOutRes.transactions
    );

    return responseHandler.success(
      req,
      res,
      _data.getResponse(),
      "successMessages.gateway.orderCreationSuccess"
    );
  } catch (error) {
    return responseHandler.error(
      req,
      res,
      error,
      "errorMessages.gateway.orderCreationFailed"
    );
  }
};

export const paypal_checkStatus = async (req, res) => {
  const isValid = validateParams(req.params, ["id"], res, req);
  if (!isValid) {
    return;
  }
  const _transID = req.params.id;

  // first check if this id is in our transaction...

  const _isValidId = await Transaction.findOne({ transId: _transID });

  if (!_isValidId) {
    return responseHandler.customError(
      req,
      res,
      "errorMessages.gateway.notValidTransactionId",
      "errorMessages.gateway.notValidTransactionId"
    );
  }

  const _body = req.body;
  const _headers = req.headers;
  const mode = req.mode;
  const userId = req.userId;

  let $paypalClientID = "";
  let $paypalSecretKey = "";
  let $paypalURL = "";
  let _credentialsUsed = __company.name;

  if (mode === Modes.sandbox) {
    // check if client send their paypal sandbox details else use own
    if (
      _body.paypal_sandbox_client_id &&
      _body.paypal_sandbox_secret_key &&
      _body.paypal_sandbox_client_id !== undefined &&
      _body.paypal_sandbox_secret_key !== undefined &&
      _body.paypal_sandbox_client_id !== "" &&
      _body.paypal_sandbox_secret_key !== "undefined"
    ) {
      $paypalClientID = _body.paypal_sandbox_client_id;
      $paypalSecretKey = _body.paypal_sandbox_secret_key;
      $paypalURL = ApiKeysSandbox[PaymentGateways.paypal].url;
      _credentialsUsed = __company.client;
    } else {
      $paypalClientID = ApiKeysSandbox[PaymentGateways.paypal].clientId;
      $paypalSecretKey = ApiKeysSandbox[PaymentGateways.paypal].secretKey;
      $paypalURL = ApiKeysSandbox[PaymentGateways.paypal].url;
    }
  } else if (mode === Modes.live) {
    const requiredValues = ["paypal_live_client_id", "paypal_live_secret_key"];
    const isValid = validateBody(_body, requiredValues, res, req);
    if (!isValid) {
      return;
    }

    if (
      _body.paypal_live_client_id &&
      _body.paypal_live_secret_key &&
      _body.paypal_live_client_id !== undefined &&
      _body.paypal_live_secret_key !== undefined &&
      _body.paypal_live_client_id !== "" &&
      _body.paypal_live_secret_key !== "undefined"
    ) {
      $paypalClientID = _body.paypal_live_client_id;
      $paypalSecretKey = _body.paypal_live_secret_key;
      $paypalURL = ApiKeysLive[PaymentGateways.paypal].url;
    } else {
      return responseHandler.customError(
        req,
        res,
        "errorMessages.gateway.gatewayCredientialsRequired",
        "errorMessages.gateway.gatewayCredientialsRequired"
      );
    }
  }

  try {
    const authResponse = await axios.post(
      `${$paypalURL}/v1/oauth2/token`,
      "grant_type=client_credentials",
      {
        auth: {
          username: $paypalClientID,
          password: $paypalSecretKey,
        },
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
        },
      }
    );

    const accessToken = authResponse.data.access_token;

    // headers
    let headers = {
      Authorization: `Bearer ${accessToken}`,
      "Content-Type": "application/json",
    };

    if (_headers["PayPal-Request-Id"]) {
      headers["PayPal-Request-Id"] = _headers["PayPal-Request-Id"];
    }

    const gatewayUrl = `${$paypalURL}/v2/checkout/orders/${_transID}`;

    const orderResponse = await axios.get(gatewayUrl, {
      headers: headers,
    });

    _isValidId.gatewayStatus = orderResponse?.data?.status;
    await _isValidId.save();

    const _transcationResObj = _isValidId.toObject();

    // delete keys from _transaction
    delete _transcationResObj.userId;
    delete _transcationResObj.headers;

    // return response object
    const _data = {
      status: orderResponse?.data?.status,
      data: orderResponse?.data,
      transaction: _transcationResObj,
    };

    return responseHandler.success(
      req,
      res,
      _data,
      "successMessages.gateway.orderStatusFetchedSuccess"
    );
  } catch (error) {
    return responseHandler.error(
      req,
      res,
      error,
      "errorMessages.gateway.orderStatusFetchFailed"
    );
  }
};

const getAccessToken = async (
  gatewayUrlAPI,
  gatewayClientId,
  gatewaySecretKey
) => {
  try {
    const authResponse = await axios.post(
      `${gatewayUrlAPI}/v1/oauth2/token`,
      "grant_type=client_credentials",
      {
        auth: {
          username: gatewayClientId,
          password: gatewaySecretKey,
        },
        headers: {
          "Content-Type": "application/x-www-form-urlencoded",
        },
      }
    );
    return authResponse.data.access_token;
  } catch (error) {
    console.error("Error fetching access token:", error);
    throw error;
  }
};

const validateBodyFields = (body, req, res) => {
  const requiredValues = [
    "intent",
    "purchase_units",
    "total_amount",
    "currency",
    "return_url",
  ];

  // first check if user sent the required fields or not...
  const isValid = validateBody(body, requiredValues, res, req);
  if (!isValid) {
    return false;
  }

  if (!validate_data(body.intent, validators.isString)) {
    responseHandler.error(
      req,
      res,
      `"intent" :  ${body.intent}`,
      "errorMessages.dataType.string"
    );
    return false;
  }

  if (!validate_data(body.purchase_units, validators.isArrayOfObjects)) {
    responseHandler.error(
      req,
      res,
      `"purchase_units" :  ${body.purchase_units}`,
      "errorMessages.dataType.arrayOfObject"
    );
    return false;
  }

  if (!validate_data(body.total_amount, validators.isString)) {
    responseHandler.error(
      req,
      res,
      `"total_amount" :  ${body.total_amount}`,
      "errorMessages.dataType.string"
    );
    return false;
  }

  if (!validate_data(body.currency, validators.isString)) {
    responseHandler.error(
      req,
      res,
      `"currency" :  ${body.currency}`,
      "errorMessages.dataType.string"
    );
    return false;
  }

  if (!validate_data(body.return_url, validators.isString)) {
    responseHandler.error(
      req,
      res,
      `"return_url" :  ${body.return_url}`,
      "errorMessages.dataType.string"
    );
    return false;
  }

  return true;
};

const createTransactionAndReturn = async (
  mode,
  gatewayUrl,
  payUrl,
  _body,
  headers,
  payload,
  orderResponse,
  userId
) => {
  try {
    // Create transaction entry object
    const transactionObj = {
      mode,
      paymentType: PaymentGateways.paypal,
      gatewayUrl,
      returnUrl: _body.return_url,
      headers,
      payload,
      response: orderResponse?.data,
      successResponse: {},
      failureResponse: {},
      payUrl,
      userId,
      transId: orderResponse?.data?.id,
      amount: _body.total_amount,
      isSuccess: false,
      isFailed: false,
      currentStatus: PaymentStatus.pending,
      currency: _body.currency,
      description: _body.description || "",
    };

    // Create and save the transaction
    const transaction = new Transaction(transactionObj);
    const savedTransaction = await transaction.save();
    const transactionResObj = savedTransaction.toObject();

    // Remove sensitive or unnecessary keys from the transaction object
    delete transactionResObj.userId;
    delete transactionResObj.headers;
    delete transactionResObj.gatewayUrl;
    delete transactionResObj.returnUrl;
    delete transactionResObj._id;

    return transactionResObj;
  } catch (error) {
    console.log("step 4");
    console.error("Error creating transaction:", error);
    throw new Error("Failed to create transaction.");
  }
};

const checkOutTrans = async (gatewayUrl, accessToken, mode, userId, _body) => {
  // payload
  let payload = {
    intent: _body.intent,
    purchase_units: _body.purchase_units,
  };

  if (_body.payment_source) {
    payload.payment_source = _body.payment_source;
    payload.payment_source.paypal.experience_context.return_url =
      CallBackUrl.paypal;
  }

  // headers
  let headers = {
    Authorization: `Bearer ${accessToken}`,
    "Content-Type": "application/json",
  };

  const orderResponse = await axios.post(gatewayUrl, payload, {
    headers: headers,
  });

  const link = orderResponse?.data?.links?.find(
    (link) => link?.rel === "payer-action"
  );

  const transactions = await createTransactionAndReturn(
    mode,
    gatewayUrl,
    link.href,
    _body,
    headers,
    payload,
    orderResponse,
    userId
  );

  return {
    payUrl: link.href,
    orderResponse,
    transactions,
  };
};
